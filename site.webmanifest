    { "name": "Transactions", "short_name": "Transactions", "description": "View transactions", "url": "/pages/transactions.html", "icons": [{ "src": "assets/icons/favicon-32.png", "sizes": "32x32" }] },
    { "name": "Budgets & Goals", "short_name": "Budgets", "description": "Manage budgets and goals", "url": "/pages/budgets.html", "icons": [{ "src": "assets/icons/favicon-32.png", "sizes": "32x32" }] }
